# 复制为 .env 后填写（.env 已在 .gitignore，勿提交）
# cp .env.example .env

# Live 面板写接口鉴权（必设，否则 start/stop 401）
MONITOR_TOKEN=

# 面板绑定
MONITOR_HOST=127.0.0.1
MONITOR_PORT=8787

# 1=状态接口附带原始日志尾（可能含敏感信息）
PANEL_INCLUDE_TAIL=0

# CPA 目录（编排器 / 面板统计）
CPA_AUTH_DIR=./cpa_auth

# 编排器可选
# ORCH_BASE_CPA=0
# ORCH_ADD_COUNT=100

# 面板跟踪的 batch 日志（默认自动发现最新 log/batch*.log）
# BATCH_LOG=
